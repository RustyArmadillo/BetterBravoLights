<Window x:Class="BravoLights.UI.LightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BravoLights.UI"
        d:DataContext="{d:DesignInstance Type=local:CombinedDataContext}"
        mc:Ignorable="d"
        Height="420" Width="700"
        MinHeight="420" MinWidth="700" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        FontSize="{Binding TextSize}"
        Closing="Window_Closing"
        Topmost="True">
    <Window.Resources>
        <local:RedBrushConverter x:Key="brushConverter" />
        <local:MultiBrushConverter x:Key="multiBrushConverter" />
    </Window.Resources>

    <Grid x:Name="MonitorGrid" CheckBox.Checked="LightTestCheckBoxChanged" CheckBox.Unchecked="LightTestCheckBoxChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Margin="8">
                Select a light to show its simulation variables.
            </TextBlock>
            <DockPanel HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBox DockPanel.Dock="Right" Text="{Binding Path=MainState.Aircraft}" IsReadOnly="True"  HorizontalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Aircraft:" HorizontalAlignment="Center" />
            </DockPanel>
        </Grid>
        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="0">
            <Border BorderBrush="Black" HorizontalAlignment="Right" VerticalAlignment="Stretch" BorderThickness="0 0 1 0" />
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0"  Tag="HDG">
                <CheckBox.Content>
                    <TextBlock Text="HDG" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.HDG, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="1"  Tag="NAV">
                <CheckBox.Content>
                    <TextBlock Text="NAV" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.NAV, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="2"  Tag="APR">
                <CheckBox.Content>
                    <TextBlock Text="APR" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.APR, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="3"  Tag="REV">
                <CheckBox.Content>
                    <TextBlock Text="REV" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.REV, Converter={StaticResource brushConverter}}"/>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="4"  Tag="ALT">
                <CheckBox.Content>
                    <TextBlock Text="ALT" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.ALT, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="5"  Tag="VS">
                <CheckBox.Content>
                    <TextBlock Text="VS" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.VS, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="6"  Tag="IAS">
                <CheckBox.Content>
                    <TextBlock Text="IAS" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.IAS, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="7"  Tag="AUTOPILOT">
                <CheckBox.Content>
                    <TextBlock Text="AUTO PILOT" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.AUTOPILOT, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"  Tag="MasterWarning">
                <CheckBox.Content>
                    <TextBlock Text="MASTER WARNING" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.MasterWarning, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"  Tag="EngineFire">
                <CheckBox.Content>
                    <TextBlock Text="ENGINE FIRE" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.EngineFire, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch"  Tag="LowOilPressure">
                <CheckBox.Content>
                    <TextBlock Text="LOW OIL PRESSURE" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.LowOilPressure, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"  Tag="LowFuelPressure">
                <CheckBox.Content>
                    <TextBlock Text="LOW FUEL PRESSURE" TextWrapping="WrapWithOverflow"  Foreground="{Binding Path=MainState.LowFuelPressure, Converter={StaticResource brushConverter}}"/>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="4" HorizontalAlignment="Stretch"  Tag="AntiIce">
                <CheckBox.Content>
                    <TextBlock Text="ANTI ICE" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.AntiIce, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="5" HorizontalAlignment="Stretch"  Tag="StarterEngaged">
                <CheckBox.Content>
                    <TextBlock Text="STARTER ENGAGED" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.StarterEngaged, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="0" Grid.Column="6" HorizontalAlignment="Stretch"  Tag="APU">
                <CheckBox.Content>
                    <TextBlock Text="APU" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.APU, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>

            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"  Tag="MasterCaution">
                <CheckBox.Content>
                    <TextBlock Text="MASTER CAUTION" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.MasterCaution, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"  Tag="Vacuum">
                <CheckBox.Content>
                    <TextBlock Text="VACUUM" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.Vacuum, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"  Tag="LowHydPressure">
                <CheckBox.Content>
                    <TextBlock Text="LOW HYD PRESSURE" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.LowHydPressure, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"  Tag="AuxFuelPump">
                <CheckBox.Content>
                    <TextBlock Text="AUX FUEL PUMP" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.AuxFuelPump, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="4" HorizontalAlignment="Stretch"  Tag="ParkingBrake">
                <CheckBox.Content>
                    <TextBlock Text="PARKING BRAKE" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.ParkingBrake, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Stretch"  Tag="LowVolts">
                <CheckBox.Content>
                    <TextBlock Text="LOW VOLTS" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.LowVolts, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="6" HorizontalAlignment="Stretch"  Tag="Door">
                <CheckBox.Content>
                    <TextBlock Text="DOOR" TextWrapping="WrapWithOverflow" Foreground="{Binding Path=MainState.Door, Converter={StaticResource brushConverter}}" />
                </CheckBox.Content>
            </CheckBox>
        </Grid>
        <Grid Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" Margin="0,4,0,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Gear N">
                <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource multiBrushConverter}">
                        <Binding Path="MainState.GearCRed" />
                        <Binding Path="MainState.GearCGreen" />
                    </MultiBinding>
                </TextBlock.Foreground>
            </TextBlock>
            <CheckBox Grid.Row="1"  Tag="GearCRed">
                <CheckBox.Content>
                    <TextBlock>Red</TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="2"  Tag="GearCGreen">
                <CheckBox.Content>
                    <TextBlock>Green</TextBlock>
                </CheckBox.Content>
            </CheckBox>
        </Grid>
        <Grid Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Left" Width="80" VerticalAlignment="Top" Margin="8,65,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Gear L">
                <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource multiBrushConverter}">
                        <Binding Path="MainState.GearLRed" />
                        <Binding Path="MainState.GearLGreen" />
                    </MultiBinding>
                </TextBlock.Foreground>
            </TextBlock>

            <CheckBox Grid.Row="1"  Tag="GearLRed">
                <CheckBox.Content>
                    <TextBlock>Red</TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="2"  Tag="GearLGreen">
                <CheckBox.Content>
                    <TextBlock>Green</TextBlock>
                </CheckBox.Content>
            </CheckBox>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" Width="80" VerticalAlignment="Top" Margin="0,65,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock HorizontalAlignment="Right" Text="Gear R">
                <TextBlock.Foreground>
                    <MultiBinding Converter="{StaticResource multiBrushConverter}">
                        <Binding Path="MainState.GearRRed" />
                        <Binding Path="MainState.GearRGreen" />
                    </MultiBinding>
                </TextBlock.Foreground>
            </TextBlock>

            <CheckBox Grid.Row="1" HorizontalAlignment="Right"  Tag="GearRRed">
                <CheckBox.Content>
                    <TextBlock>Red</TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox Grid.Row="2" HorizontalAlignment="Right"  Tag="GearRGreen">
                <CheckBox.Content>
                    <TextBlock>Green</TextBlock>
                </CheckBox.Content>
            </CheckBox>
        </Grid>
        <local:ExpressionAndVariables Grid.Row="3" Grid.ColumnSpan="2" Margin="8" DataContext="{Binding Path=ExpressionAndVariablesViewModel}" />
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="TestModeToggle" Content="Bravo test mode" ToolTip="Select any combination of lights to test. Outside test mode, one check marks the light being monitored."
                          VerticalAlignment="Center"
                          Checked="TestMode_Changed" Unchecked="TestMode_Changed" />
                <Button Margin="8,0,0,0" Padding="6,2" Content="All On" Click="AllLightsOn_Click"
                        IsEnabled="{Binding IsChecked, ElementName=TestModeToggle}" />
                <Button Margin="4,0,0,0" Padding="6,2" Content="All Off" Click="AllLightsOff_Click"
                        IsEnabled="{Binding IsChecked, ElementName=TestModeToggle}" />
            </StackPanel>
            <DockPanel Grid.Column="1" LastChildFill="False" HorizontalAlignment="Right">
                <TextBlock Text="Text size:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TextSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Width="120" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding TextSize, Mode=TwoWay}" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
